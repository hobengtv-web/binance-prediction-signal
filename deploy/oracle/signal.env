# ENV produksi binance-prediction-signal (dari Railway) — untuk Oracle VM.
# Cara pakai: isi file ini sebagai environment pm2 (lihat setup-signal.sh).
export PORT=8000
export LEDGER_DIR=/data/ledger
export LEARN_WINDOW_SEC=172800
export ONLINE_REFIT=1
export REFIT_INTERVAL_HOURS=1
export REFIT_CHECK_MIN=5
export GATE_REQUIRE_GRADE=1
export GATE_LOOSEN_KEEP_LIQ=1
export GATE_LOOSEN_MOM=0
export FLAT_ENTRY=1
export FLAT_ENTRY_RSI=40
export GOLDEN_MOM_MV2=0.03
export KEY_EV_GATE=1
export KEY_TRADE_MIN_EV=-8
export KEY_TRADE_MIN_N=20
export KEY_TRADE_WIN_H=24
export LATE_MV60=0.02
export LATE_SIGNAL=1
export MIN_MV2_PCT=0.005
export RSI1M_GATE=1
export TA_15M_TRAIL_GAP_PP=0
export TA_15M_TRAIL_MIN_HOLD_MS=20000
export TA_BE_STOP=0
export TA_ENTRY_MIN_NOW_PCT=0
export TA_ENTRY_MIN_REMAIN_SEC=90
export TA_HYBRID=0
export TA_SIMPLE=1
export TA_TRAIL_ARM_ON_LOCK=0
export TA_TRAIL_ARM_PCT=50
export TA_TRAIL_CB_PCT=0.12
export TA_TRAIL_GAP_PP=0
export TA_TRAIL_MIN_HOLD_MS=10000
